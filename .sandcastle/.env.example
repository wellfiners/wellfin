# Copy to .sandcastle/.env and fill. Never commit .env.
# Sandcastle resolves secrets from .sandcastle/.env only (ignores repo root .env).

# For opencode / Claude Code OAuth (run `claude setup-token` on host if using Claude)
CLAUDE_CODE_OAUTH_TOKEN=
# Or Anthropic API key alternative
ANTHROPIC_API_KEY=

# GitHub — required for `gh issue view` inside sandbox
GH_TOKEN=

# Optional: agent model override
# OPENCODE_MODEL=opencode/big-pickle
